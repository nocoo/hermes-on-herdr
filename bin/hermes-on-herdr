#!/usr/bin/python3 -IS
"""Use OS Python only to validate the private interpreter hint, then exec the venv."""

import argparse
import json
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from hermes_gateway_herdr import __version__
from hermes_gateway_herdr.errors import GatewayError
from hermes_gateway_herdr.paths import check_private, json_object, private_bytes, trusted_path


def launch():
    parser = argparse.ArgumentParser(prog="hermes-on-herdr", add_help=False, allow_abbrev=False)
    parser.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    parser.add_argument("--config", type=Path)
    options, arguments = parser.parse_known_args()
    config = options.config
    if config is None:
        directory = os.environ.get("HERDR_PLUGIN_CONFIG_DIR")
        if not directory:
            if "--help" in arguments or "-h" in arguments:
                print("Usage: hermes-on-herdr --config /absolute/config.json COMMAND\n"
                      "       hermes-on-herdr --version\n"
                      "Commands: ensure, supervise, start, resume, pause, stop, restart, status, doctor, logs, bind, dashboard\n"
                      "Configure a private config.json and runtime-python before use. bind defaults to a dry run.")
                return 0
            raise GatewayError("SETUP_REQUIRED")
        config = Path(directory) / "config.json"
    if not config.is_absolute():
        raise GatewayError("CONFIG_ERROR")
    trusted_path(str(config.parent), directory=True)
    check_private(config.parent.stat(), directory=True)
    hint = private_bytes(config.parent / "runtime-python", 4096).decode().splitlines()
    if len(hint) != 1:
        raise GatewayError("CONFIG_ERROR")
    interpreter = trusted_path(hint[0])
    data = json_object(private_bytes(config, 65536), code="CONFIG_ERROR")
    if not isinstance(data, dict) or data.get("python_bin") != str(interpreter) or not os.access(interpreter, os.X_OK):
        raise GatewayError("CONFIG_ERROR")
    trusted_path(str(ROOT), directory=True)
    entry = trusted_path(str(ROOT / "src" / "hermes_gateway_herdr" / "__main__.py"))
    os.execv(str(interpreter), [str(interpreter), "-I", "-B", str(entry), "--config", str(config), *arguments])


if __name__ == "__main__":
    try:
        raise SystemExit(launch())
    except (GatewayError, OSError, ValueError, UnicodeError) as error:
        code = error.code if isinstance(error, GatewayError) else "CONFIG_ERROR"
        print(json.dumps({"schema": 1, "state": "ERROR", "code": code}))
        raise SystemExit(20)
